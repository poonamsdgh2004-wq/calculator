import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

from sklearn.model_selection import train_test_split
from sklearn.compose import ColumnTransformer
from sklearn.pipeline import Pipeline
from sklearn.preprocessing import OneHotEncoder, StandardScaler
from sklearn.impute import SimpleImputer
from sklearn.linear_model import LinearRegression, LogisticRegression

from sklearn.metrics import (
    mean_absolute_error,
    mean_squared_error,
    r2_score,
    confusion_matrix,
    accuracy_score,
    precision_score,
    recall_score,
    f1_score,
    classification_report
)

import warnings
warnings.filterwarnings("ignore")

df = pd.read_csv("student_performance.csv")

print("Dataset Shape:", df.shape)
display(df.head())

print("\nColumn Names:")
print(df.columns.tolist())

print("\nData Types:")
print(df.dtypes)

print("\nDataset Information:")
df.info()

print("\nStatistical Summary:")
display(df.describe(include="all"))

print("\nMissing Values:")
print(df.isnull().sum())

print("\nMissing Value Percentage:")
print((df.isnull().sum() / len(df)) * 100)

print("\nDuplicate Rows:", df.duplicated().sum())

df = df.drop_duplicates()

numerical_columns = df.select_dtypes(
    include=np.number
).columns.tolist()

categorical_columns = df.select_dtypes(
    exclude=np.number
).columns.tolist()

print("\nNumerical Variables:")
print(numerical_columns)

print("\nCategorical Variables:")
print(categorical_columns)

df[numerical_columns].hist(
    figsize=(16, 12),
    bins=20
)

plt.tight_layout()
plt.show()

plt.figure(figsize=(8, 5))
sns.histplot(
    df["exam_score"],
    kde=True,
    bins=20
)
plt.title("Distribution of Exam Scores")
plt.xlabel("Exam Score")
plt.ylabel("Number of Students")
plt.show()

plt.figure(figsize=(16, 8))
sns.boxplot(data=df[numerical_columns])
plt.title("Boxplot of Numerical Variables")
plt.xticks(rotation=45)
plt.show()

correlation_matrix = df[numerical_columns].corr()

plt.figure(figsize=(14, 10))
sns.heatmap(
    correlation_matrix,
    annot=True,
    cmap="coolwarm",
    fmt=".2f"
)
plt.title("Correlation Matrix")
plt.show()

exam_score_correlation = (
    df[numerical_columns]
    .corr()["exam_score"]
    .sort_values(ascending=False)
)

print("\nCorrelation with Exam Score:")
display(exam_score_correlation)

features_to_plot = [
    "study_hours_per_day",
    "attendance_percentage",
    "sleep_hours",
    "social_media_hours",
    "netflix_hours",
    "exercise_frequency",
    "mental_health_rating"
]

for feature in features_to_plot:
    if feature in df.columns:
        plt.figure(figsize=(7, 5))
        sns.scatterplot(
            data=df,
            x=feature,
            y="exam_score"
        )
        plt.title(f"{feature} vs Exam Score")
        plt.xlabel(feature)
        plt.ylabel("Exam Score")
        plt.show()

for col in categorical_columns:
    if col != "exam_score":
        print(f"\n{col}:")
        print(df[col].value_counts().head(10))

        if df[col].nunique() <= 10:
            plt.figure(figsize=(8, 5))
            sns.boxplot(
                data=df,
                x=col,
                y="exam_score"
            )
            plt.title(f"{col} vs Exam Score")
            plt.xticks(rotation=45)
            plt.show()

X = df.drop(columns=["exam_score"])
y = df["exam_score"]

numeric_features = X.select_dtypes(
    include=np.number
).columns.tolist()

categorical_features = X.select_dtypes(
    exclude=np.number
).columns.tolist()

numeric_transformer = Pipeline(
    steps=[
        ("imputer", SimpleImputer(strategy="median")),
        ("scaler", StandardScaler())
    ]
)

categorical_transformer = Pipeline(
    steps=[
        ("imputer", SimpleImputer(strategy="most_frequent")),
        (
            "onehot",
            OneHotEncoder(
                handle_unknown="ignore",
                sparse_output=False
            )
        )
    ]
)

preprocessor = ColumnTransformer(
    transformers=[
        (
            "num",
            numeric_transformer,
            numeric_features
        ),
        (
            "cat",
            categorical_transformer,
            categorical_features
        )
    ]
)

X_train, X_test, y_train, y_test = train_test_split(
    X,
    y,
    test_size=0.20,
    random_state=42
)

regression_model = Pipeline(
    steps=[
        ("preprocessor", preprocessor),
        ("model", LinearRegression())
    ]
)

regression_model.fit(
    X_train,
    y_train
)

y_train_pred = regression_model.predict(X_train)
y_test_pred = regression_model.predict(X_test)

train_mae = mean_absolute_error(
    y_train,
    y_train_pred
)

train_mse = mean_squared_error(
    y_train,
    y_train_pred
)

train_rmse = np.sqrt(train_mse)

train_r2 = r2_score(
    y_train,
    y_train_pred
)

test_mae = mean_absolute_error(
    y_test,
    y_test_pred
)

test_mse = mean_squared_error(
    y_test,
    y_test_pred
)

test_rmse = np.sqrt(test_mse)

test_r2 = r2_score(
    y_test,
    y_test_pred
)

print("\nLINEAR REGRESSION RESULTS")

print("\nTraining:")
print("MAE:", round(train_mae, 4))
print("MSE:", round(train_mse, 4))
print("RMSE:", round(train_rmse, 4))
print("R2:", round(train_r2, 4))

print("\nTesting:")
print("MAE:", round(test_mae, 4))
print("MSE:", round(test_mse, 4))
print("RMSE:", round(test_rmse, 4))
print("R2:", round(test_r2, 4))

regression_comparison = pd.DataFrame({
    "Metric": ["MAE", "MSE", "RMSE", "R2 Score"],
    "Training": [
        train_mae,
        train_mse,
        train_rmse,
        train_r2
    ],
    "Testing": [
        test_mae,
        test_mse,
        test_rmse,
        test_r2
    ]
})

display(regression_comparison)

plt.figure(figsize=(8, 6))

sns.scatterplot(
    x=y_test,
    y=y_test_pred
)

plt.xlabel("Actual Exam Score")
plt.ylabel("Predicted Exam Score")
plt.title("Actual vs Predicted Exam Scores")

min_value = min(
    y_test.min(),
    y_test_pred.min()
)

max_value = max(
    y_test.max(),
    y_test_pred.max()
)

plt.plot(
    [min_value, max_value],
    [min_value, max_value],
    linestyle="--"
)

plt.show()

df["Pass_Fail"] = np.where(
    df["exam_score"] >= 50,
    1,
    0
)

print("\nPass/Fail Distribution:")
print(df["Pass_Fail"].value_counts())

print("\nPass/Fail Percentage:")
print(
    df["Pass_Fail"]
    .value_counts(normalize=True)
    .mul(100)
)

X_classification = df.drop(
    columns=["exam_score", "Pass_Fail"]
)

y_classification = df["Pass_Fail"]

numeric_features_class = (
    X_classification
    .select_dtypes(include=np.number)
    .columns
    .tolist()
)

categorical_features_class = (
    X_classification
    .select_dtypes(exclude=np.number)
    .columns
    .tolist()
)

numeric_transformer_class = Pipeline(
    steps=[
        ("imputer", SimpleImputer(strategy="median")),
        ("scaler", StandardScaler())
    ]
)

categorical_transformer_class = Pipeline(
    steps=[
        (
            "imputer",
            SimpleImputer(strategy="most_frequent")
        ),
        (
            "onehot",
            OneHotEncoder(
                handle_unknown="ignore",
                sparse_output=False
            )
        )
    ]
)

preprocessor_class = ColumnTransformer(
    transformers=[
        (
            "num",
            numeric_transformer_class,
            numeric_features_class
        ),
        (
            "cat",
            categorical_transformer_class,
            categorical_features_class
        )
    ]
)

X_train_class, X_test_class, y_train_class, y_test_class = train_test_split(
    X_classification,
    y_classification,
    test_size=0.20,
    random_state=42,
    stratify=y_classification
)

classification_model = Pipeline(
    steps=[
        ("preprocessor", preprocessor_class),
        (
            "model",
            LogisticRegression(max_iter=1000)
        )
    ]
)

classification_model.fit(
    X_train_class,
    y_train_class
)

y_train_class_pred = classification_model.predict(
    X_train_class
)

y_test_class_pred = classification_model.predict(
    X_test_class
)

train_accuracy = accuracy_score(
    y_train_class,
    y_train_class_pred
)

test_accuracy = accuracy_score(
    y_test_class,
    y_test_class_pred
)

train_precision = precision_score(
    y_train_class,
    y_train_class_pred,
    zero_division=0
)

test_precision = precision_score(
    y_test_class,
    y_test_class_pred,
    zero_division=0
)

train_recall = recall_score(
    y_train_class,
    y_train_class_pred,
    zero_division=0
)

test_recall = recall_score(
    y_test_class,
    y_test_class_pred,
    zero_division=0
)

train_f1 = f1_score(
    y_train_class,
    y_train_class_pred,
    zero_division=0
)

test_f1 = f1_score(
    y_test_class,
    y_test_class_pred,
    zero_division=0
)

print("\nLOGISTIC REGRESSION RESULTS")

print("\nTraining:")
print("Accuracy:", round(train_accuracy, 4))
print("Precision:", round(train_precision, 4))
print("Recall:", round(train_recall, 4))
print("F1 Score:", round(train_f1, 4))

print("\nTesting:")
print("Accuracy:", round(test_accuracy, 4))
print("Precision:", round(test_precision, 4))
print("Recall:", round(test_recall, 4))
print("F1 Score:", round(test_f1, 4))

cm = confusion_matrix(
    y_test_class,
    y_test_class_pred
)

print("\nConfusion Matrix:")
print(cm)

plt.figure(figsize=(6, 5))

sns.heatmap(
    cm,
    annot=True,
    fmt="d",
    cmap="Blues",
    xticklabels=["Fail", "Pass"],
    yticklabels=["Fail", "Pass"]
)

plt.xlabel("Predicted")
plt.ylabel("Actual")
plt.title("Confusion Matrix")
plt.show()

print("\nClassification Report:")

print(
    classification_report(
        y_test_class,
        y_test_class_pred,
        target_names=["Fail", "Pass"],
        zero_division=0
    )
)

classification_comparison = pd.DataFrame({
    "Metric": [
        "Accuracy",
        "Precision",
        "Recall",
        "F1 Score"
    ],
    "Training": [
        train_accuracy,
        train_precision,
        train_recall,
        train_f1
    ],
    "Testing": [
        test_accuracy,
        test_precision,
        test_recall,
        test_f1
    ]
})

display(classification_comparison)

plt.figure(figsize=(7, 5))

plt.bar(
    ["Training R2", "Testing R2"],
    [train_r2, test_r2]
)

plt.ylabel("R2 Score")
plt.title("Regression Training vs Testing Performance")
plt.show()

plt.figure(figsize=(7, 5))

plt.bar(
    ["Training Accuracy", "Testing Accuracy"],
    [train_accuracy, test_accuracy]
)

plt.ylabel("Accuracy")
plt.title("Classification Training vs Testing Accuracy")
plt.ylim(0, 1)
plt.show()

feature_names = (
    regression_model
    .named_steps["preprocessor"]
    .get_feature_names_out()
)

coefficients = (
    regression_model
    .named_steps["model"]
    .coef_
)

coefficient_df = pd.DataFrame({
    "Feature": feature_names,
    "Coefficient": coefficients
})

coefficient_df["Absolute_Coefficient"] = (
    coefficient_df["Coefficient"].abs()
)

coefficient_df = coefficient_df.sort_values(
    by="Absolute_Coefficient",
    ascending=False
)

print("\nTop Important Features:")
display(coefficient_df.head(15))

top_features = (
    coefficient_df
    .head(15)
    .sort_values("Coefficient")
)

plt.figure(figsize=(10, 7))

plt.barh(
    top_features["Feature"],
    top_features["Coefficient"]
)

plt.xlabel("Regression Coefficient")
plt.ylabel("Feature")
plt.title("Top Features Influencing Exam Score")
plt.tight_layout()
plt.show()

r2_difference = train_r2 - test_r2

print("\nMODEL DIAGNOSIS")

if train_r2 < 0.50 and test_r2 < 0.50:
    print("Regression: Possible underfitting.")

elif r2_difference > 0.15:
    print("Regression: Possible overfitting.")

else:
    print("Regression: No strong evidence of overfitting or underfitting.")

accuracy_difference = train_accuracy - test_accuracy

if train_accuracy > 0.90 and test_accuracy < 0.75:
    print("Classification: Possible overfitting.")

elif train_accuracy < 0.60 and test_accuracy < 0.60:
    print("Classification: Possible underfitting.")

else:
    print("Classification: No strong evidence of overfitting or underfitting.")

corr_values = (
    df[numerical_columns]
    .corr()["exam_score"]
    .drop("exam_score")
)

strongest_positive = corr_values.idxmax()
strongest_negative = corr_values.idxmin()

positive_value = corr_values.max()
negative_value = corr_values.min()

pass_percentage = df["Pass_Fail"].mean() * 100

print("\n" + "=" * 70)
print("5 MEANINGFUL INSIGHTS")
print("=" * 70)

print(
    f"\n1. {strongest_positive} has the strongest positive "
    f"correlation with exam_score ({positive_value:.2f})."
)

print(
    f"\n2. {strongest_negative} has the strongest negative "
    f"correlation with exam_score ({negative_value:.2f})."
)

print(
    f"\n3. {pass_percentage:.2f}% of students achieved "
    f"a passing score of 50 or above."
)

print(
    f"\n4. Linear Regression achieved a testing R2 of "
    f"{test_r2:.2f} and RMSE of {test_rmse:.2f}."
)

print(
    f"\n5. Logistic Regression achieved testing accuracy of "
    f"{test_accuracy:.2f}, precision of {test_precision:.2f}, "
    f"recall of {test_recall:.2f}, and F1-score of {test_f1:.2f}."
)

final_summary = pd.DataFrame({
    "Model": [
        "Linear Regression",
        "Logistic Regression"
    ],
    "Training Score": [
        train_r2,
        train_accuracy
    ],
    "Testing Score": [
        test_r2,
        test_accuracy
    ]
})

print("\nFinal Model Summary:")
display(final_summary)
