import pandas as pd
import numpy as np
from google.colab import files

print("=" * 70)
print("DAY 7 - DATASET SUMMARY REPORT")
print("=" * 70)


# ================================================================
# 1. UPLOAD AND LOAD CSV DATASET
# ================================================================

print("\n1. UPLOAD CSV DATASET")
print("-" * 50)

uploaded = files.upload()

# Automatically get the uploaded file name
file_path = list(uploaded.keys())[0]

# Load CSV into Pandas DataFrame
df = pd.read_csv(file_path)

print("File Loaded Successfully:", file_path)


# ================================================================
# 2. FIRST 5 ROWS
# ================================================================

print("\n2. FIRST 5 ROWS")
print("-" * 50)

print(df.head())


# ================================================================
# 3. FIRST 10 ROWS
# ================================================================

print("\n3. FIRST 10 ROWS")
print("-" * 50)

print(df.head(10))


# ================================================================
# 4. LAST 5 ROWS
# ================================================================

print("\n4. LAST 5 ROWS")
print("-" * 50)

print(df.tail())


# ================================================================
# 5. LAST 10 ROWS
# ================================================================

print("\n5. LAST 10 ROWS")
print("-" * 50)

print(df.tail(10))


# ================================================================
# 6. RANDOM SAMPLE
# ================================================================

print("\n6. RANDOM SAMPLE")
print("-" * 50)

sample_size = min(5, len(df))

print(df.sample(sample_size))


# ================================================================
# 7. DATASET SHAPE
# ================================================================

print("\n7. DATASET SHAPE")
print("-" * 50)

rows, columns = df.shape

print("Shape:", df.shape)
print("Number of Rows:", rows)
print("Number of Columns:", columns)


# ================================================================
# 8. COLUMN NAMES / FEATURES
# ================================================================

print("\n8. COLUMN NAMES / FEATURES")
print("-" * 50)

print("Columns:")
for column in df.columns:
    print("-", column)


# ================================================================
# 9. DATASET INDEX
# ================================================================

print("\n9. DATASET INDEX")
print("-" * 50)

print(df.index)


# ================================================================
# 10. DATA TYPES
# ================================================================

print("\n10. DATA TYPES")
print("-" * 50)

print(df.dtypes)


# ================================================================
# 11. DATASET INFORMATION
# ================================================================

print("\n11. DATASET INFORMATION")
print("-" * 50)

df.info()


# ================================================================
# 12. DESCRIPTIVE STATISTICS
# ================================================================

print("\n12. DESCRIPTIVE STATISTICS")
print("-" * 50)

print(df.describe())


# ================================================================
# 13. DESCRIPTIVE STATISTICS INCLUDING CATEGORICAL DATA
# ================================================================

print("\n13. COMPLETE DESCRIPTIVE STATISTICS")
print("-" * 50)

print(df.describe(include="all"))


# ================================================================
# 14. MISSING VALUES
# ================================================================

print("\n14. MISSING VALUES")
print("-" * 50)

missing_values = df.isnull().sum()

print(missing_values)


# ================================================================
# 15. MISSING VALUE PERCENTAGE
# ================================================================

print("\n15. MISSING VALUE PERCENTAGE")
print("-" * 50)

missing_percentage = (df.isnull().sum() / len(df)) * 100

missing_report = pd.DataFrame({
    "Missing Values": df.isnull().sum(),
    "Missing Percentage": missing_percentage.round(2)
})

print(missing_report)


# ================================================================
# 16. TOTAL MISSING VALUES
# ================================================================

print("\n16. TOTAL MISSING VALUES")
print("-" * 50)

total_missing = df.isnull().sum().sum()

print("Total Missing Values:", total_missing)


# ================================================================
# 17. DUPLICATE ROWS
# ================================================================

print("\n17. DUPLICATE ROWS")
print("-" * 50)

duplicate_rows = df.duplicated().sum()

print("Number of Duplicate Rows:", duplicate_rows)


# ================================================================
# 18. UNIQUE VALUES
# ================================================================

print("\n18. UNIQUE VALUES IN EACH COLUMN")
print("-" * 50)

for column in df.columns:
    print(f"{column}: {df[column].nunique()} unique values")


# ================================================================
# 19. NUMERICAL COLUMNS
# ================================================================

print("\n19. NUMERICAL COLUMNS")
print("-" * 50)

numerical_columns = df.select_dtypes(include=np.number).columns

print("Numerical Columns:")
print(list(numerical_columns))


# ================================================================
# 20. CATEGORICAL COLUMNS
# ================================================================

print("\n20. CATEGORICAL COLUMNS")
print("-" * 50)

categorical_columns = df.select_dtypes(
    include=["object", "category"]
).columns

print("Categorical Columns:")
print(list(categorical_columns))


# ================================================================
# 21. COLUMN TYPE SUMMARY
# ================================================================

print("\n21. COLUMN TYPE SUMMARY")
print("-" * 50)

print("Total Columns:", len(df.columns))
print("Numerical Columns:", len(numerical_columns))
print("Categorical Columns:", len(categorical_columns))


# ================================================================
# 22. MISSING VALUE CHECK FOR EACH COLUMN
# ================================================================

print("\n22. MISSING VALUE CHECK BY COLUMN")
print("-" * 50)

for column in df.columns:

    missing = df[column].isnull().sum()

    if missing > 0:
        print(f"{column}: {missing} missing values")
    else:
        print(f"{column}: No missing values")


# ================================================================
# 23. NUMERICAL DATA SUMMARY
# ================================================================

print("\n23. NUMERICAL DATA SUMMARY")
print("-" * 50)

if len(numerical_columns) > 0:

    print("Mean:")
    print(df[numerical_columns].mean())

    print("\nMinimum:")
    print(df[numerical_columns].min())

    print("\nMaximum:")
    print(df[numerical_columns].max())

else:

    print("No numerical columns found.")


# ================================================================
# 24. BASIC OBSERVATIONS
# ================================================================

print("\n" + "=" * 70)
print("24. BASIC OBSERVATIONS")
print("=" * 70)

print(
    f"\n1. The dataset contains {rows} rows "
    f"and {columns} columns."
)

print("\n2. Available Features:")

for column in df.columns:
    print("   -", column)


print(
    f"\n3. The dataset contains "
    f"{len(numerical_columns)} numerical columns "
    f"and {len(categorical_columns)} categorical columns."
)


if total_missing == 0:
    print("\n4. There are no missing values in the dataset.")
else:
    print(
        f"\n4. The dataset contains "
        f"{total_missing} missing values."
    )


if duplicate_rows == 0:
    print("\n5. There are no duplicate rows.")
else:
    print(
        f"\n5. The dataset contains "
        f"{duplicate_rows} duplicate rows."
    )


# ================================================================
# 25. FINAL DATASET SUMMARY
# ================================================================

print("\n" + "=" * 70)
print("FINAL DATASET SUMMARY REPORT")
print("=" * 70)

print("\nDataset File:", file_path)
print("Number of Rows:", rows)
print("Number of Columns:", columns)

print("\nFeatures:")
print(list(df.columns))

print("\nData Types:")
print(df.dtypes)

print("\nTotal Missing Values:", total_missing)
print("Total Duplicate Rows:", duplicate_rows)

print("\nNumerical Columns:")
print(list(numerical_columns))

print("\nCategorical Columns:")
print(list(categorical_columns))


# ================================================================
# 26. CONCLUSION
# ================================================================

print("\n" + "=" * 70)
print("CONCLUSION")
print("=" * 70)

