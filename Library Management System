class Book:
    def __init__(self, id, title):
        self.id = id
        self.title = title
        self.available = True

    def show(self):
        print(self.id, self.title, "Available" if self.available else "Issued")


class Library:
    def __init__(self):
        self.books = []
        self.issued = {}
        self.categories = set()

    def add(self):
        try:
            id = int(input("Book ID: "))
            title = input("Title: ")
            category = input("Category: ")
            self.books.append(Book(id, title))
            self.categories.add(category)
            print("Book added")
        except ValueError:
            print("Invalid ID")

    def show(self):
        if not self.books:
            print("No books")
        for b in self.books:
            b.show()

    def search(self):
        name = input("Enter title: ").lower()
        for b in self.books:
            if name in b.title.lower():
                b.show()

    def issue(self):
        try:
            id = int(input("Book ID: "))
            name = input("Student name: ")
            for b in self.books:
                if b.id == id:
                    if b.available:
                        b.available = False
                        self.issued[id] = name
                        print("Book issued")
                    else:
                        print("Already issued")
                    return
            print("Book not found")
        except ValueError:
            print("Invalid ID")

    def return_book(self):
        try:
            id = int(input("Book ID: "))
            for b in self.books:
                if b.id == id:
                    b.available = True
                    self.issued.pop(id, None)
                    print("Book returned")
                    return
            print("Book not found")
        except ValueError:
            print("Invalid ID")

    def save(self):
        with open("library.txt", "w") as f:
            for b in self.books:
                f.write(f"{b.id},{b.title}\n")


l = Library()

while True:
    print("\n1.Add  2.Show  3.Search  4.Issue  5.Return  6.Save  7.Exit")

    try:
        ch = int(input("Choice: "))

        if ch == 1:
            l.add()
        elif ch == 2:
            l.show()
        elif ch == 3:
            l.search()
        elif ch == 4:
            l.issue()
        elif ch == 5:
            l.return_book()
        elif ch == 6:
            l.save()
            print("Saved")
        elif ch == 7:
            print("Thank you")
            break
        else:
            print("Invalid choice")

    except ValueError:
        print("Enter a number")
