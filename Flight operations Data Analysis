# Flight Operations Data Analysis - Day 10
# ==========================================

# Step 1: Import Libraries
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

# ------------------------------------------
# Step 2: Load Dataset
# ------------------------------------------

# Upload your CSV file in Google Colab
from google.colab import files
uploaded = files.upload()

# Replace with your uploaded file name
df = pd.read_csv(list(uploaded.keys())[0])

# ------------------------------------------
# Step 3: Display Dataset
# ------------------------------------------

print("First 5 Rows")
display(df.head())

print("\nLast 5 Rows")
display(df.tail())

# ------------------------------------------
# Step 4: Dataset Information
# ------------------------------------------

print("\nShape of Dataset")
print(df.shape)

print("\nColumns")
print(df.columns)

print("\nInformation")
print(df.info())

print("\nMissing Values")
print(df.isnull().sum())

print("\nStatistical Summary")
display(df.describe())

# ------------------------------------------
# Step 5: Data Cleaning
# ------------------------------------------

# Remove duplicate rows
df = df.drop_duplicates()

# Fill missing numeric values
numeric_columns = df.select_dtypes(include=np.number).columns
df[numeric_columns] = df[numeric_columns].fillna(df[numeric_columns].mean())

# Fill missing categorical values
categorical_columns = df.select_dtypes(include="object").columns
df[categorical_columns] = df[categorical_columns].fillna("Unknown")

# ------------------------------------------
# Step 6: Selecting Columns
# ------------------------------------------

print("\nSelecting First Two Columns")
display(df.iloc[:,0:2])

# ------------------------------------------
# Step 7: Filtering Data
# ------------------------------------------

# Example: Flights delayed more than 30 minutes
if "DepartureDelay" in df.columns:
    delayed = df[df["DepartureDelay"] > 30]
    print("Flights delayed more than 30 minutes")
    display(delayed.head())

# ------------------------------------------
# Step 8: Sorting
# ------------------------------------------

numeric_cols = df.select_dtypes(include=np.number).columns

if len(numeric_cols) > 0:
    sorted_df = df.sort_values(by=numeric_cols[0], ascending=False)
    print("Sorted Data")
    display(sorted_df.head())

# ------------------------------------------
# Step 9: Grouping and Aggregation
# ------------------------------------------

# Example if Airline column exists
if "Airline" in df.columns:

    if "DepartureDelay" in df.columns:
        airline_delay = df.groupby("Airline")["DepartureDelay"].mean()
        print(airline_delay)

    elif len(numeric_cols)>0:
        airline_data = df.groupby("Airline")[numeric_cols[0]].mean()
        print(airline_data)

# ------------------------------------------
# Step 10: Data Transformation
# ------------------------------------------

if "DepartureDelay" in df.columns:

    df["DelayStatus"] = df["DepartureDelay"].apply(
        lambda x: "Delayed" if x > 15 else "On Time"
    )

    display(df.head())

# ------------------------------------------
# Step 11: Value Counts
# ------------------------------------------

for col in categorical_columns:
    print(f"\nValue Counts of {col}")
    print(df[col].value_counts().head())

# ------------------------------------------
# Step 12: Correlation
# ------------------------------------------

if len(numeric_cols) > 1:

    print("\nCorrelation Matrix")
    display(df[numeric_cols].corr())

# ------------------------------------------
# Step 13: Visualization
# ------------------------------------------

if "Airline" in df.columns:

    df["Airline"].value_counts().plot(
        kind="bar",
        figsize=(8,5),
        title="Flights by Airline"
    )
    plt.xlabel("Airline")
    plt.ylabel("Number of Flights")
    plt.show()

if "DepartureDelay" in df.columns:

    df["DepartureDelay"].plot(
        kind="hist",
        bins=20,
        figsize=(8,5),
        title="Departure Delay Distribution"
    )
    plt.xlabel("Delay")
    plt.show()

# ------------------------------------------
# Step 14: Final Dataset
# ------------------------------------------

print("Final Dataset")
display(df.head())

# Save cleaned dataset
df.to_csv("Cleaned_Flight_Data.csv", index=False)

print("Analysis Completed Successfully")
